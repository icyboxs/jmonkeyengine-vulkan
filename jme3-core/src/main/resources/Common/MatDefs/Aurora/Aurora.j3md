MaterialDef Simple {
    //This is the complete list of user defined uniforms to be used in the
    //shaders
    MaterialParameters {
        Vector4 Color
        Float Time
		Texture2D ExtraTex
		Texture2D ExtraTex1
		Texture2D ExtraTex2
    }
    Technique {
        //This is where the vertex and fragment shader files are
        //specified
        VertexShader GLSL100 GLSL120 GLSL130 GLSL150 GLSL450:   Common/MatDefs/Aurora/AuroraVertex.vert
        FragmentShader GLSL100 GLSL120 GLSL130 GLSL150 GLSL450: Common/MatDefs/Aurora/AuroraFrag.frag
        //This is where you specify which global uniform you need for your
        //shaders
        WorldParameters {
            WorldViewProjectionMatrix
            Resolution
            Time
        }
    }

}