// VKSkinning.glsllib
// Vulkan version (GLSL 450)

#ifdef NUM_BONES

#if NUM_BONES < 1 || NUM_BONES > 255
#error NUM_BONES must be between 1 and 255.
#endif

#define NUM_WEIGHTS_PER_VERT 4

// Adjust locations to your vertex layout
layout(location = 4) in vec4  inHWBoneWeight;
// Prefer uvec4; if your current VB stores float indices, change this to vec4 and cast with int(...)
layout(location = 5) in uvec4 inHWBoneIndex;

// Vulkan: non-opaque uniform must be in a block
layout(set = 1, binding = 1) uniform Bones {
    mat4 m_BoneMatrices[NUM_BONES];
};

void Skinning_Compute(inout vec4 position){
    if (inHWBoneWeight.x != 0.0) {
    #if NUM_WEIGHTS_PER_VERT == 1
        position = m_BoneMatrices[inHWBoneIndex.x] * position;
    #else
        mat4 mat = mat4(0.0);
        mat += m_BoneMatrices[inHWBoneIndex.x] * inHWBoneWeight.x;
        mat += m_BoneMatrices[inHWBoneIndex.y] * inHWBoneWeight.y;
        mat += m_BoneMatrices[inHWBoneIndex.z] * inHWBoneWeight.z;
        mat += m_BoneMatrices[inHWBoneIndex.w] * inHWBoneWeight.w;
        position = mat * position;
    #endif
    }
}

void Skinning_Compute(inout vec4 position, inout vec3 normal){
    if (inHWBoneWeight.x != 0.0) {
    #if NUM_WEIGHTS_PER_VERT == 1
        position = m_BoneMatrices[inHWBoneIndex.x] * position;
        normal = mat3(
            m_BoneMatrices[inHWBoneIndex.x][0].xyz,
            m_BoneMatrices[inHWBoneIndex.x][1].xyz,
            m_BoneMatrices[inHWBoneIndex.x][2].xyz
        ) * normal;
    #else
        mat4 mat = mat4(0.0);
        mat += m_BoneMatrices[inHWBoneIndex.x] * inHWBoneWeight.x;
        mat += m_BoneMatrices[inHWBoneIndex.y] * inHWBoneWeight.y;
        mat += m_BoneMatrices[inHWBoneIndex.z] * inHWBoneWeight.z;
        mat += m_BoneMatrices[inHWBoneIndex.w] * inHWBoneWeight.w;
        position = mat * position;

        mat3 rotMat = mat3(mat[0].xyz, mat[1].xyz, mat[2].xyz);
        normal = rotMat * normal;
    #endif
    }
}

void Skinning_Compute(inout vec4 position, inout vec3 normal, inout vec3 tangent){
    if (inHWBoneWeight.x != 0.0) {
    #if NUM_WEIGHTS_PER_VERT == 1
        position = m_BoneMatrices[inHWBoneIndex.x] * position;

        mat3 rotMat = mat3(
            m_BoneMatrices[inHWBoneIndex.x][0].xyz,
            m_BoneMatrices[inHWBoneIndex.x][1].xyz,
            m_BoneMatrices[inHWBoneIndex.x][2].xyz
        );
        tangent = rotMat * tangent;
        normal  = rotMat * normal;
    #else
        mat4 mat = mat4(0.0);
        mat += m_BoneMatrices[inHWBoneIndex.x] * inHWBoneWeight.x;
        mat += m_BoneMatrices[inHWBoneIndex.y] * inHWBoneWeight.y;
        mat += m_BoneMatrices[inHWBoneIndex.z] * inHWBoneWeight.z;
        mat += m_BoneMatrices[inHWBoneIndex.w] * inHWBoneWeight.w;
        position = mat * position;

        mat3 rotMat = mat3(mat[0].xyz, mat[1].xyz, mat[2].xyz);
        tangent = rotMat * tangent;
        normal  = rotMat * normal;
    #endif
    }
}

#endif
